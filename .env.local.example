# ─────────────────────────────────────────────────────────────────────────────
# Saaranshi — environment variables
#
# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is gitignored.
#
# Variable naming:
#   NEXT_PUBLIC_*  → exposed to the browser bundle (safe for anon/public keys)
#   Everything else → server-only (service keys, DB passwords, API secrets)
# ─────────────────────────────────────────────────────────────────────────────

# ── SUPABASE ──────────────────────────────────────────────────────────────────
# Project URL from: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Anon/public key — safe to expose in the browser
# From: Supabase dashboard → Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Service role key — NEVER expose this client-side
# From: Supabase dashboard → Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── DATABASE (Drizzle ORM direct connection) ──────────────────────────────────
# Use the Session mode pooler URL from: Supabase dashboard → Settings → Database → Connection string
# Session mode (port 5432) works best with Drizzle's postgres.js driver.
# Format: postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# IMPORTANT: URL-encode special characters in the password (@ → %40, # → %23, % → %25, etc.)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Direct connection — use only for running migrations (drizzle-kit migrate)
# From: Supabase dashboard → Settings → Database → Connection string → URI
DATABASE_URL_DIRECT=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# ── CLOUDFLARE R2 (Phase 2 — audio storage) ───────────────────────────────────
# From: Cloudflare dashboard → R2 → Manage R2 API tokens
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com/<bucket-name>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com/saaranshi-audio
R2_BUCKET_NAME=saaranshi-audio
# Cloudflare API token (for signed URL generation)
CLOUDFLARE_TOKEN=<cloudflare-api-token>

# ── SARVAM AI (Phase 2 — Telugu/English transcription) ────────────────────────
# From: https://dashboard.sarvam.ai → API Keys
# Used for speech-to-text with code-switching support (en + te)
SARVAM_API_KEY=sk_...

# ── ANTHROPIC (Phase 4 — analysis workspace) ──────────────────────────────────
# From: https://console.anthropic.com → API Keys
# Sonnet 4.5 for chat/findings, Haiku 4.5 for structured extraction
ANTHROPIC_API_KEY=sk-ant-...

# ── GEMINI (Phase 4 — embeddings, free tier) ──────────────────────────────────
# From: https://aistudio.google.com/apikey
# Used for text-embedding-004 (768-dim) — focus points, transcript chunks, RAG queries
GEMINI_API_KEY=...

# ── ANALYSIS TUNING (Phase 4) ─────────────────────────────────────────────────
# Cosine-similarity threshold for Layer 2 cross-interview theme clustering (0–1).
# Higher = tighter clusters. Start at 0.78 and tune.
CLUSTER_SIMILARITY_THRESHOLD=0.78
